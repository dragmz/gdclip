[configuration]

entry_symbol = "gdclip_library_init"
compatibility_minimum = "4.2"

[libraries]

linux.debug.x86_64 = "res://bin/libgdclip.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libgdclip.linux.template_release.x86_64.so"
linux.debug.arm64 = "res://bin/libgdclip.linux.template_debug.arm64.so"
linux.release.arm64 = "res://bin/libgdclip.linux.template_release.arm64.so"
macos.debug = "res://bin/libgdclip.macos.template_debug.framework"
macos.release = "res://bin/libgdclip.macos.template_release.framework"
windows.debug.x86_64 = "res://bin/libgdclip.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libgdclip.windows.template_release.x86_64.dll"
